							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var locationId = jsonData._id || jsonData.id;",
									"pm.globals.set(\"test_location_id\", locationId);",
									"pm.globals.set(\"test_location_barcode\", jsonData.barcode);",
									"",
