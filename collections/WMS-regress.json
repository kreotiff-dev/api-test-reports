			"name": "0. Подготовка переменных",
			"item": [
				{
					"name": "Генерация уникальных значений",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Генерация уникальных значений",
									"var timestamp = new Date().getTime();",
									"",
									"// Уникальные ID для товаров и заказов",
									"pm.globals.set(\"order_number\", \"ORD-\" + timestamp);",
									"pm.globals.set(\"product_sku_1\", \"SKU-\" + timestamp + \"-1\");",
									"pm.globals.set(\"product_sku_2\", \"SKU-\" + timestamp + \"-2\");",
									"pm.globals.set(\"product_id_1\", \"PROD-\" + timestamp + \"-1\");",
									"pm.globals.set(\"product_id_2\", \"PROD-\" + timestamp + \"-2\");",
									"pm.globals.set(\"product_barcode_1\", \"BAR-\" + timestamp + \"-1\");",
									"pm.globals.set(\"product_barcode_2\", \"BAR-\" + timestamp + \"-2\");",
									"pm.globals.set(\"employee_id\", \"EMP-\" + timestamp);",
									"",
									"console.log(\"Уникальные значения сгенерированы:\");",
									"console.log(\"Номер заказа: \" + pm.globals.get(\"order_number\"));",
									"console.log(\"SKU 1: \" + pm.globals.get(\"product_sku_1\"));",
									"console.log(\"SKU 2: \" + pm.globals.get(\"product_sku_2\"));",
									"",
									"pm.test(\"Уникальные переменные сгенерированы\", function () {",
									"    pm.expect(pm.globals.get(\"order_number\")).to.not.be.undefined;",
									"    pm.expect(pm.globals.get(\"product_sku_1\")).to.not.be.undefined;",
									"    pm.expect(pm.globals.get(\"employee_id\")).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}",
							"host": [
								"{{baseUrl}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Проверка существующих ячеек",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"",
									"// Используем существующие ячейки, если они есть",
									"if (jsonData && jsonData.length > 0) {",
									"    // Берем первую ячейку",
									"    var locationId = jsonData[0]._id || jsonData[0].id;",
									"    pm.globals.set(\"test_location_id\", locationId);",
									"    console.log(\"Установлен test_location_id: \" + locationId);",
									"    pm.globals.set(\"test_location_barcode\", jsonData[0].barcode);",
									"    console.log(\"Установлен test_location_barcode: \" + jsonData[0].barcode);",
									"} else {",
									"    console.log(\"Существующие ячейки не найдены, нужно создать новую\");",
									"    pm.globals.set(\"need_to_create_location\", true);",
									"}",
									"",
									"pm.test(\"Запрос выполнен успешно\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/locations",
							"host": [
								"{{baseUrl}}"
							],
